{
  "name": "system-design-lab",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:api": "pnpm --filter @sdl/api dev",
    "dev:worker": "pnpm --filter @sdl/worker dev",
    "dev:scheduler": "pnpm --filter @sdl/scheduler dev",
    "db:migrate": "pnpm --filter @sdl/db migrate",
    "db:seed": "pnpm --filter @sdl/db seed",
    "infra:up": "docker compose -f infra/compose/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/compose/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/compose/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
